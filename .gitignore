# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/

# editor / tooling local state
.claude/
.vscode/
.idea/

# Written by scripts/bootstrap.sh: discovered oracle paths, and any tool it had
# to fetch because the distribution does not package it.
scripts/env.sh
.tools/

# Generated test corpora and conversion outputs (all reproducible)
testkit/adv/
testkit/real/
testkit/batch/
testkit/edge/
testkit/sweep/
testkit/chromefix_off/
testkit/chromefix_on/
testkit/quirks/
testkit/holdout/
testkit/hdiff/
testkit/parity/
testkit/regroup/
testkit/exp_off/
testkit/exp_on/
testkit/expansion_out/
testkit/expansion_build/
# Downloaded originals staged by fetch_expansion.py. The bytes that matter are
# the ones sealed into testkit/fixtures_expansion/; this is the landing area,
# and it also holds documents that were fetched and then deliberately NOT sealed
# (see docs/corpus-expansion.md section 9), which must not reach the repository.
# The glob covers the per-round directories (fetched_expansion_r3, ...) as well:
# the round-1 pattern was exact and round 3 landed outside it, one `git add -A`
# away from committing a 15.3 MB document that was deliberately discarded.
testkit/fetched_expansion*/
corpus/pdfs/

# Scratch space for debugging artifacts: rendered before/after PNGs, one-off
# conversions, copies of a fixture being investigated. Five such files were
# committed by an over-broad `git add` in 0d3d03e, whose message was "Updating
# .md files." One of them was a copy of `l1_word_native.pdf` with the SAME
# content fingerprint as the frozen fixture and DIFFERENT bytes -- 81,769
# against 44,035 -- so nothing a reader could see distinguished them, and only
# the manifest's sha256 could. A same-named, differently-sized shadow of a
# gated input is the exact hazard the manifests exist to prevent, so the
# directory that produces them is ignored rather than policed.
tmp/

# Google API credentials -- never commit these.
# Patterns are deliberately broad: Google's download name is
# client_secret_<id>.apps.googleusercontent.com.json, which a narrower glob
# silently fails to match, leaving the secret staged by `git add -A`.
credentials.json
token.json
.gdocs_orphans.json
client_secret*
*client_secret*
*apps.googleusercontent.com.json
*.pem
.env

# personal test inputs -- never publish
my_samples/

# Private working notes -- not for publication. The planning and review
# documents all share the form "exactdoc — <something>.md" and live in the repo
# root beside the tracked docs, which is one `git add -A` away from publishing
# them. The tracked docs (README, STATUS, THEORY, FINDINGS) do not carry the
# prefix, so this pattern cannot catch them by accident.
Executor Advisory.md
exactdoc — *.md
*Execution Plan*.md
# The em-dash pattern above missed `exactdoc-production-readiness-plan.md`, which
# is the same kind of document under a hyphen. Match the suffix as well: no
# tracked doc ends in -plan.md.
*-plan.md
